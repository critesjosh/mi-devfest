# Copy to .env.local and fill in from your team's IBM Cloud hackathon account.
# Never commit .env.local.
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
# Region endpoint of your watsonx.ai instance, e.g. https://us-south.ml.cloud.ibm.com
WATSONX_URL=https://us-south.ml.cloud.ibm.com
# Pick a Granite chat model your project can use (check Prompt Lab). Confirm with `npm run smoke`.
WATSONX_MODEL_ID=ibm/granite-4-h-small
# Set to 1 to use recorded sample output instead of calling watsonx.ai (offline dev / outage fallback).
SHIFTPROOF_OFFLINE=0
